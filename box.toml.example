# box.toml — factory configuration
# schema = "box/1.0"
#
# Copy this to box.toml and customize.
# Place box.toml in ~/workspace/factory/ or wherever your factory instance lives.

# ── Runtime ───────────────────────────────────────────────────────────────────

[runtime]
executor = "remote-docker"  # local | docker | remote-docker | ssh
provider = "claude"          # claude | opencode
target   = "worker"          # logical name — resolved from targets.toml (gitignored)
                             # targets.toml maps "worker" → actual SSH host for this machine

# Docker image config — used by docker and remote-docker executors
# remote-docker: image must be present on the target machine (build there or push to a registry)
[runtime.docker]
image   = "box-worker:latest"
runtime = "kata"        # optional: kata for Kata VM isolation on Linux; ignored silently on Mac

# Backward compat: direct SSH host (prefer target + targets.toml instead)
# [runtime.ssh]
# host = "korora"       # hostname or tailscale name
# user = "ubuntu"       # omit to use current user

# OpenCode provider config — used when provider = "opencode"
[runtime.opencode]
model   = "9router/glm/glm-5.3-flash"
api_url = "http://100.102.189.40:20128/v1"
api_key = "${OPENAI_API_KEY}"

# Claude provider config — used when provider = "claude"
[runtime.claude]
# api_key defaults to $ANTHROPIC_API_KEY

# ── Context — tacit knowledge injected into every worker ─────────────────────

[context]
# Files loaded and prepended to every worker's context.
# Paths are expanded (~ supported). Missing files are skipped with a warning.
standards = [
    "~/workspace/agents/docs/standards/coding.md",
    "~/workspace/agents/docs/standards/prose.md",
    "~/workspace/agents/docs/standards/git.md",
    "~/workspace/agents/docs/standards/testing.md",
]
workspace_map = "~/workspace/agents/docs/workspace/projects.toml"

# ── Projects ──────────────────────────────────────────────────────────────────

[[projects]]
name    = "my-project"
path    = "~/workspace/my-project"
repo    = "owner/my-project"   # github owner/repo — required for docker executor (enables clone mode)
workers = 1             # max concurrent workers for this project

# Per-project service requirements (provision before worker runs)
[projects.services]
infisical = false       # pull secrets from Infisical before task

# Per-project context additions (merged with global context.standards)
[projects.context]
extra = []              # extra files to inject for this project only
